APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://queue:queue@localhost:5432/queue
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=job-results
RESULT_UPLOAD_URL_SECONDS=300
METRICS_TOKEN=replace-with-a-long-random-token
METRICS_PORT=0

WORKER_GATEWAY_URL=http://localhost:8000
WORKER_GATEWAY_TOKEN=replace-with-a-long-random-token
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_OFFLINE_AFTER_SECONDS=60
WORKER_LONG_POLL_SECONDS=20
JOB_LEASE_SECONDS=60
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300
SCHEDULER_BATCH_SIZE=100
SCHEDULER_POLL_INTERVAL_SECONDS=1
RECOVERY_BATCH_SIZE=100
RECOVERY_POLL_INTERVAL_SECONDS=1
MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1
