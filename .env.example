APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_DIST_DIR=frontend/dist
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false

DATABASE_URL=postgresql+psycopg://queue:queue@localhost:5432/queue
TEST_DATABASE_URL=postgresql+psycopg://queue:queue@localhost:5432/queue_test
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=job-results
RESULT_UPLOAD_URL_SECONDS=300
MINIO_HANDLER_BUCKET=handler-artifacts
HANDLER_UPLOAD_URL_SECONDS=300
HANDLER_DOWNLOAD_URL_SECONDS=300
HANDLER_MAX_BYTES=10485760
HANDLER_MAX_UNCOMPRESSED_BYTES=52428800
HANDLER_SANDBOX_IMAGE=python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217
HANDLER_SANDBOX_MEMORY_MB=256
HANDLER_SANDBOX_MILLICPUS=500
HANDLER_SANDBOX_PIDS=64
HANDLER_SANDBOX_TIMEOUT_SECONDS=300
HANDLER_SANDBOX_MAX_OUTPUT_BYTES=1048576
# Base64-encoded raw Ed25519 keys. Keep the private key only on API/Admin processes.
HANDLER_SIGNING_KEY_ID=replace-with-key-id
HANDLER_SIGNING_PRIVATE_KEY=
HANDLER_TRUSTED_PUBLIC_KEYS={"replace-with-key-id":"base64-raw-public-key"}
METRICS_TOKEN=replace-with-a-long-random-token
METRICS_PORT=0
# Optional Prometheus-compatible query API used only by the Admin overview.
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_TIMEOUT_SECONDS=5

WORKER_GATEWAY_URL=http://localhost:8000
# Issued once through POST /worker-management/enrollments; required only by a worker process.
WORKER_ENROLLMENT_TOKEN=
WORKER_CREDENTIAL_HOURS=24
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_OFFLINE_AFTER_SECONDS=60
WORKER_LONG_POLL_SECONDS=20
JOB_LEASE_SECONDS=60
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300
SCHEDULER_BATCH_SIZE=100
SCHEDULER_POLL_INTERVAL_SECONDS=1
RECOVERY_BATCH_SIZE=100
RECOVERY_POLL_INTERVAL_SECONDS=1
MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1

# First Compose startup only. Existing accounts are never reset on restart.
BOOTSTRAP_ADMIN_EMAIL=admin@relay.local
BOOTSTRAP_ADMIN_PASSWORD=
# Optional localhost port overrides for a second, isolated Compose project.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# API_PORT=8000
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000 (for API outside Compose)
