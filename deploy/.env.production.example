# Copy to deploy/.env.production on the server. Keep that file private.
RELAY_DOMAIN=relay.example.com
RELAY_STORAGE_DOMAIN=storage.relay.example.com

# Generate independent values, for example with: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-long-random-database-password
DATABASE_URL=postgresql+psycopg://queue:replace-with-long-random-database-password@postgres:5432/queue
MINIO_ROOT_USER=replace-with-random-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-long-random-minio-secret
METRICS_TOKEN=replace-with-long-random-metrics-token

# Used only when the Admin account does not already exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-random-bootstrap-password
